# ---------------------------------------------------------------------------
# Hydrogen Storefront Environment Variables
# Copy to .env and fill in values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Storefront (required) ---
# These are set up when you create the Hydrogen sales channel in Shopify Admin
SESSION_SECRET=your-session-secret-min-32-chars-long
PUBLIC_STORE_DOMAIN=your-store.myshopify.com
PUBLIC_STOREFRONT_API_TOKEN=your-public-storefront-api-token
PUBLIC_STOREFRONT_ID=your-storefront-id
PUBLIC_CHECKOUT_DOMAIN=checkout.your-store.com

# --- Shopify Admin API (optional, for Draft Order creation) ---
# Create a Custom App in Shopify Admin → Settings → Apps → Develop apps
# Scope needed: draft_orders[write], draft_orders[read]
SHOPIFY_ADMIN_API_TOKEN=

# --- Notifications (optional, for Quote auto-notification) ---
# Slack Incoming Webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
# Microsoft Teams Incoming Webhook: channel → Connectors
TEAMS_WEBHOOK_URL=

# --- Webhook verification (optional, for Flow webhook endpoint) ---
SHOPIFY_WEBHOOK_SECRET=
